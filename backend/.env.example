# Database
DATABASE_URL=sqlite+aiosqlite:///./mlpilot.db

# AI Providers (all optional - StubProvider works without any key)
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=true
LOG_LEVEL=INFO

# AI defaults
DEFAULT_AI_PROVIDER=stub
DEFAULT_AI_MODEL=stub-default
